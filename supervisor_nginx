ngnix------------- config

upstream pwmckmlapi {
    server 127.0.0.1:8003;
    server 127.0.0.1:8004;
}

server {
    listen 80;
    listen [::]:80;

    server_name mlapi-publishwise-sandbox.evalueserve.com;

    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name mlapi-publishwise-sandbox.evalueserve.com;

    ssl_certificate /etc/ssl/evalueserve.com.crt;
    ssl_certificate_key /etc/ssl/evalueserve.com.key;

    client_max_body_size 32M;

    access_log /var/log/nginx/pwmckmlapi-access.log;
    error_log /var/log/nginx/pwmckmlapi-error.log;

    location /static {
        autoindex on;
        alias /home/eitcsupport/pwmckmlapi/PublishWise-PS-ML/static;
    }

    location / {
        include /etc/nginx/proxy_params;
        proxy_read_timeout 120s;
        proxy_pass http://pwmckmlapi;
    }
}

